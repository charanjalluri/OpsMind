# ==============================================================================
# OpsMind — .gitignore
# ==============================================================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT REAL CREDENTIALS)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!backend/.env.example
!frontend/.env.example

# Python virtual environments & interpreters
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/

# Testing & linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
coverage/

# Node & Frontend dependencies / build output
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
dist-ssr/
build/
.vite/
*.local

# Design & IDE tools cache
.impeccable/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# Databases & local storage
*.db
*.sqlite
*.sqlite3

# Logs & temporary files
*.log
logs/
temp/
tmp/
*.tmp
*.bak
*.swp
*~

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
